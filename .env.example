# الباك إند (Laravel). API_URL يُقرأ على الخادم فقط، وVITE_API_URL يصل للمتصفح.
API_URL="http://localhost:8000"
VITE_API_URL="http://localhost:8000"

# Reverb — البثّ الحيّ للأسعار. القيم من ملف .env في ora-backend.
# VITE_* تُحقن وقت البناء، فتغييرها يحتاج إعادة بناء لا إعادة تشغيل.
VITE_REVERB_APP_KEY=""
VITE_REVERB_HOST="localhost"
VITE_REVERB_PORT="8090"
VITE_REVERB_SCHEME="http"

# Firebase — إشعارات المتصفح. من Firebase Console ← Project settings:
# الأربعة الأولى من «Your apps» (تطبيق Web)، والـ VAPID من Cloud Messaging ← Web Push certificates.
# فاضية = إشعارات المتصفح مقفولة، والجرس وReverb شغالين عادي.
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
VITE_FIREBASE_VAPID_KEY=""
